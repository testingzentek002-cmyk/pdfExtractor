# Anthropic Claude API key (paste your key here when you have one)
ANTHROPIC_API_KEY=your_key_here

# Set to "true" to use Claude API for extraction instead of the rule-based parser
USE_CLAUDE=true

# Claude model to use (only relevant when USE_CLAUDE=true)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Batch size for Claude extraction (default 9, as per BLAST spec)
BATCH_SIZE=9

# Logging level: "info" | "verbose" | "silent"
LOG_LEVEL=info

# Vercel Blob read/write token. When set, the web UI uploads PDFs directly to
# Blob storage instead of through the server, bypassing Vercel's 4.5 MB
# serverless function request-body limit. Create a Blob store in the Vercel
# dashboard (Storage tab) and connect it to this project to get this value;
# `vercel env pull` will fetch it into your local .env automatically. Leave
# unset for local dev without Blob — uploads then go straight to /upload.
BLOB_READ_WRITE_TOKEN=
